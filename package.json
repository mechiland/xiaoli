{
  "name": "xiaoli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:ensure": "tsx scripts/dev-ensure.ts",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply xiaoli --local",
    "db:reset": "tsx scripts/db-reset.ts",
    "seed": "tsx scripts/run-owned.ts scripts/seed/index.ts verify-seed --",
    "verify": "tsx scripts/run-owned.ts verify/cli.ts verify-seed --",
    "verify:list": "tsx scripts/run-owned.ts verify/cli.ts verify-seed -- --list",
    "eval": "tsx scripts/run-owned.ts eval/src/cli.ts eval-synthetic -- run",
    "eval:annotate-view": "tsx scripts/run-owned.ts eval/src/cli.ts eval-synthetic -- annotate-view",
    "eval:gold-template": "tsx scripts/run-owned.ts eval/src/cli.ts eval-synthetic -- gold-template",
    "eval:validate-gold": "tsx scripts/run-owned.ts eval/src/cli.ts eval-synthetic -- validate-gold",
    "eval:freeze-gold": "tsx scripts/run-owned.ts eval/src/cli.ts eval-synthetic -- freeze-gold",
    "synthetic:generate": "tsx scripts/run-owned.ts scripts/synthetic/generate.ts eval-synthetic --",
    "extract:offline": "tsx scripts/run-owned.ts scripts/extract-offline.ts extract --",
    "extract:gen-prompts": "tsx scripts/run-owned.ts server/extract/scripts/gen-prompts.ts extract --",
    "extract:cassettes": "tsx scripts/run-owned.ts server/extract/__fixtures__/build-cassettes.ts extract --",
    "llm:usage": "tsx scripts/run-owned.ts scripts/llm-usage.ts llm --",
    "llm:smoke": "tsx scripts/run-owned.ts server/llm/smoke.ts llm --",
    "preview:prod": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@hono/zod-validator": "0.9.1",
    "@opennextjs/cloudflare": "1.20.6",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "hono": "4.13.8",
    "lucide-react": "1.46.0",
    "lunar-typescript": "1.8.6",
    "next": "16.3.5",
    "pinyin-pro": "3.29.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260915.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "playwright": "1.63.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "4.131.2"
  }
}
